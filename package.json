{
  "name": "noclash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "validate:data": "tsx scripts/validate-data.ts",
    "import:paste": "tsx scripts/import-paste.ts",
    "check:size": "tsx scripts/check-size.ts",
    "admin": "vite --config vite.admin.config.ts --host"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  },
